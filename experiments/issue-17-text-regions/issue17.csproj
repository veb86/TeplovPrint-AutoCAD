<Project Sdk="Microsoft.NET.Sdk">
  <!-- Issue #17 experiment: compiles only the CAD-free sources and compares old per-axis vs new uniform scale. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../src/Common/Models/Models.cs" />
    <Compile Include="../../src/Common/Geometry/FrameTextRegionGeometry.cs" />
  </ItemGroup>
</Project>
