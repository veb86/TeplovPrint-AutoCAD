<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZwcadBatchPlot"
        x:Class="ZwcadBatchPlot.RectangleBatchPlotForm"
        Title="Teplov Print — универсальная пакетная печать V1.0.7"
        Width="900" Height="520"
        MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F5F7FA"
        FontFamily="Segoe UI"
        FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WpfUi.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        
        <Border DockPanel.Dock="Bottom" Height="30"
                Background="#EBEFF4" BorderBrush="#C8CDD4" BorderThickness="0,1,0,0">
            <TextBlock x:Name="_status" VerticalAlignment="Center"
                       Margin="8,0,0,0" Foreground="#374151" TextTrimming="CharacterEllipsis" />
        </Border>

        
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8,3,0,3">
            <Button x:Name="_scaleSettingsBtn" Content="Масштабы" MinWidth="76"
                    Style="{StaticResource PluginButtonStyle}" Margin="0,0,4,0"
                    Click="ScaleSettings_Click"
                    ToolTip="Открыть страницу настройки масштабов универсальной пакетной печати." />
            <Button x:Name="_sortSettingsBtn" Content="Сортировка" MinWidth="76"
                    Style="{StaticResource PluginButtonStyle}" Margin="0,0,4,0"
                    Click="SortSettings_Click"
                    ToolTip="Выбрать пространственный порядок и отсортировать текущий список." />
            <Button x:Name="_generalSettingsBtn" Content="Основные" MinWidth="76"
                    Style="{StaticResource PluginButtonStyle}"
                    Click="GeneralSettings_Click"
                    ToolTip="Настроить допуск формата бумаги, распознавание рамок из четырёх линий и другие параметры." />
        </StackPanel>

        
        <StackPanel DockPanel.Dock="Top" Margin="10,4,10,2">
            
            <StackPanel Orientation="Horizontal">
                <Button x:Name="_scanCurrentBtn" Content="Сканировать чертёж" MinWidth="108"
                        Style="{StaticResource PluginButtonStyle}" Margin="0,0,3,0"
                        Click="ScanCurrentDrawing_Click"
                        ToolTip="Найти в текущем чертеже все прямоугольные рамки с подходящими пропорциями." />
                <Button x:Name="_scanObjectsBtn" Content="Выбрать рамки" MinWidth="92"
                        Style="{StaticResource PluginButtonStyle}" Margin="0,0,3,0"
                        Click="ScanSelectedObjects_Click"
                        ToolTip="Вернуться в CAD и выбрать объекты; правой кнопкой можно выбрать область сканирования." />
                <Button x:Name="_addFilesBtn" Content="Несколько DWG" MinWidth="108"
                        Style="{StaticResource PluginButtonStyle}" Margin="0,0,3,0"
                        Click="AddDwgFiles_Click"
                        ToolTip="Выбрать несколько DWG, указать модель или листы и добавить найденные рамки в список." />
                <Rectangle Width="1" Height="14" Fill="#CDD2D8"
                           Margin="4,0,12,0" VerticalAlignment="Center" />
                <Button x:Name="_refreshBtn" Content="Обновить" MinWidth="88"
                        Style="{StaticResource PluginButtonStyle}" Margin="0,0,3,0"
                        Click="ReloadFrames_Click"
                        ToolTip="Повторить последнее сканирование и обновить список рамок." />
                <Button x:Name="_clearBtn" Content="Очистить список" MinWidth="92"
                        Style="{StaticResource PluginButtonStyle}" Margin="0,0,3,0"
                        Click="ClearRows_Click"
                        ToolTip="Очистить список рамок, не изменяя файлы CAD." />
                <TextBlock Text="Правой кнопкой: исключить из печати, удалить или изменить бумагу"
                           Foreground="DimGray" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="98" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="172" />
                    <ColumnDefinition Width="98" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Вывод" VerticalAlignment="Center" />
                <TextBox x:Name="_outputDirectory" Grid.Column="1"
                         VerticalContentAlignment="Center" Margin="0,0,8,0"
                         TextChanged="OutputDirectory_TextChanged"
                         LostFocus="OutputDirectory_LostFocus" />
                <Button x:Name="_browseButton" Grid.Column="2" Content="Обзор..." MinWidth="84"
                        Style="{StaticResource PluginButtonStyle}" Margin="0,0,8,0"
                        Click="BrowseOutputDirectory_Click"
                        ToolTip="Выбрать папку для выходных файлов." />
                <TextBlock Grid.Column="3" Text="Формат" VerticalAlignment="Center" />
                <ComboBox x:Name="_outputFormatCombo" Grid.Column="4" IsEditable="False"
                          VerticalContentAlignment="Center" Margin="0,0,8,0"
                          SelectionChanged="OutputFormat_SelectionChanged" />
                <TextBlock Grid.Column="5" Text="CTB" VerticalAlignment="Center" />
                <Grid Grid.Column="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="_style" Grid.Column="0" IsEditable="False"
                              VerticalContentAlignment="Center" Margin="0,0,4,0"
                              SelectionChanged="Style_SelectionChanged" />
                    <Button x:Name="_styleSettingsButton" Grid.Column="1" Content="Настроить" MinWidth="56"
                            Style="{StaticResource PluginButtonStyle}" IsEnabled="False"
                            Click="StyleSettings_Click"
                            ToolTip="Открыть настройки выбранного стиля печати CTB." />
                </Grid>
                <Button x:Name="_printButton" Grid.Column="7" Content="Начать печать" MinWidth="98"
                        Style="{StaticResource PluginButtonStyle}"
                        Background="#0078D7" Foreground="White" BorderBrush="#005FAA"
                        Click="PrintOrStop_Click" />
            </Grid>

            
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Путь сохранения:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="_savePathModeCombo" Width="170" IsEditable="False"
                          VerticalContentAlignment="Center" Margin="0,0,8,0"
                          SelectionChanged="SavePathMode_SelectionChanged" />
                <CheckBox x:Name="_mergePdf" Content="Объединить PDF" VerticalAlignment="Center"
                          Margin="4,0,8,0"
                          ToolTip="Только для PDF; закладки и объединение по формату бумаги настраиваются в параметрах пакетной печати." />
                <StackPanel x:Name="_marginPanel" Orientation="Horizontal"
                            ToolTip="Для PDF/DWF/PNG/JPG: положительное значение увеличивает бумагу при прежнем масштабе; отрицательное уменьшает содержимое по центру.">
                    <CheckBox x:Name="_leaveMargin" Content="Поля" VerticalAlignment="Center"
                              Margin="4,0,4,0" Checked="LeaveMargin_CheckedChanged"
                              Unchecked="LeaveMargin_CheckedChanged" />
                    <ComboBox x:Name="_marginInput" Width="58" IsEditable="False"
                              VerticalContentAlignment="Center" Margin="0,0,2,0" />
                    <TextBlock Text="mm" VerticalAlignment="Center" Margin="2,0,0,0" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        
        <DataGrid x:Name="_grid" Style="{StaticResource PluginGridStyle}"
                  Margin="10,2,10,6"
                  AutoGenerateColumns="False"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  Sorting="Grid_Sorting"
                  ContextMenuOpening="Grid_ContextMenuOpening"
                  PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown"
                  PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Selected}" Value="False" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Foreground" Value="Gray" />
                            <Setter Property="Background" Value="#F7F7F7" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="№" Width="52" IsReadOnly="True" SortMemberPath="Number" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Number}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Просмотр" Width="62" SortMemberPath="Number" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Открыть" Padding="6,0" MinHeight="20"
                                    Click="PreviewButton_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Печать" Width="62" SortMemberPath="Selected" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                      Click="PrintCheck_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="_drawingNumberColumn" Header="№ листа"
                                    Binding="{Binding DrawingNumber}"
                                    Width="120" MinWidth="80" IsReadOnly="True"
                                    SortMemberPath="DrawingNumber"
                                    Visibility="Collapsed" />
                <DataGridTextColumn x:Name="_titleColumn" Header="Наименование"
                                    Binding="{Binding Title}"
                                    Width="160" MinWidth="100" IsReadOnly="True"
                                    SortMemberPath="Title"
                                    Visibility="Collapsed" />
                <DataGridTextColumn Header="Имя файла" Binding="{Binding FileName}"
                                    Width="*" MinWidth="170" IsReadOnly="True"
                                    SortMemberPath="FileName" />
                <DataGridTemplateColumn Header="Размер бумаги / масштаб" Width="*" MinWidth="200" SortMemberPath="PaperChoice" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding PaperOptions}"
                                      SelectedItem="{Binding PaperChoice, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center"
                                      SelectionChanged="PaperChoice_SelectionChanged" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="_changePaperItem" Header="Изменить бумагу..." Click="BatchChangePaper_Click" />
                    <Separator />
                    <MenuItem x:Name="_markNotPrintItem" Header="Не печатать" Click="MarkNotPrint_Click" />
                    <MenuItem x:Name="_deleteItem" Header="Удалить" Click="DeleteHighlighted_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </DockPanel>
</Window>
