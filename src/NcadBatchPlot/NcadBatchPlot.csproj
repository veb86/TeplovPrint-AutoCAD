<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWpf>true</UseWpf>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.7</Version>
    <!--
      Four-part version on purpose: WPF writes it into the pack URI of every XAML page
      ("/NcadBatchPlot;V1.0.0.0;component/...") and looks for an already loaded assembly with Version.Equals.
      "1.0.0" (Revision = -1) never equals the loaded 1.0.0.0, so WPF loaded a second copy of the plugin and
      nanoCAD 24 failed with "the component does not have a resource identified by the URI" (issue #3).
    -->
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>1.0.7</FileVersion>
    <InformationalVersion>1.0.7</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyName>NcadBatchPlot</AssemblyName>
    <RootNamespace>ZwcadBatchPlot</RootNamespace>
    <DefineConstants>$(DefineConstants);AUTOCAD;NANOCAD</DefineConstants>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(RepoRoot)bin-nanocad24\</OutputPath>
    <DocnetRuntime>win-x64</DocnetRuntime>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>


  <ItemGroup>
    <Compile Include="..\Common\**\*.cs" />
    <Compile Include="..\AutoCAD\**\*.cs" />
    <Page Include="..\Common\**\*.xaml">
      <Link>Common\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <EmbeddedResource Include="..\AutoCAD\**\*.resx" />

    <ProjectReference Include="..\PianNoCN\PianNoCN.csproj" />
    <None Remove="..\Common\**\*" />
    <None Remove="..\AutoCAD\**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(RepoRoot)resources\acad\Plotters\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Plotters\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="ModPlus.nanoCAD.API.24" Version="2.0.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
  </ItemGroup>


  <Target Name="CopyPdfiumForCadHost" AfterTargets="Build">
    <PropertyGroup>
      <_PdfiumSrc>$(NuGetPackageRoot)docnet.core\2.6.0\runtimes\win-x64\native\pdfium.dll</_PdfiumSrc>
    </PropertyGroup>
    <Copy SourceFiles="$(_PdfiumSrc)" DestinationFiles="$(OutputPath)pdfium.dll" SkipUnchangedFiles="true" Condition="Exists('$(_PdfiumSrc)')" />
  </Target>
</Project>
